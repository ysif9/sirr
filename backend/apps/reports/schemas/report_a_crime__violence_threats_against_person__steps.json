{
  "report_type_key": "report_a_crime",
  "category_key": "violence_threats_against_person",
  "report_type_title": "Report a Crime",
  "category_title": "Violence & Threats Against a Person",
  "category_subtitle": "Physical harm, threats, or offenses against liberty.",
  "fields": {
    "location": {
      "label": "Where did this happen?",
      "type": "location",
      "helperText": "Provide an address or mark on the map.",
      "validation": {
        "required": true
      },
      "step_title": "Incident Details"
    },
    "incident_date": {
      "label": "Date of Incident",
      "type": "date",
      "validation": {
        "required": true
      },
      "step_title": "Incident Details"
    },
    "incident_time": {
      "label": "Time of Incident",
      "type": "time",
      "validation": {
        "required": true
      },
      "step_title": "Incident Details"
    },
    "incident_description": {
      "label": "Please describe what happened in detail.",
      "type": "textarea",
      "placeholder": "Describe the events in the order they occurred...",
      "validation": {
        "required": true
      },
      "step_title": "Incident Details"
    },
    "victim_identity": {
      "label": "Who was the victim?",
      "type": "radio_group",
      "options": [
        "I was",
        "Someone else"
      ],
      "validation": {
        "required": true
      },
      "step_title": "Victim Information"
    },
    "victim_name": {
      "label": "Victim's Full Name",
      "type": "text",
      "conditional": {
        "field": "victim_identity",
        "value": "Someone else"
      },
      "step_title": "Victim Information"
    },
    "child_involved": {
      "label": "Was a child endangered?",
      "type": "radio_group",
      "options": [
        "Yes",
        "No",
        "Unsure"
      ],
      "step_title": "Victim Information"
    },
    "anyone_injured": {
      "label": "Was any one injured?",
      "type": "radio_group",
      "options": [
        "Yes",
        "No",
        "Unsure"
      ],
      "step_title": "Victim Information"
    },
    "victim_injuries": {
      "label": "What injuries, if any, were sustained?",
      "type": "textarea",
      "placeholder": "e.g., cuts, bruises, broken bones.",
      "step_title": "Victim Information"
    },
    "suspect_count": {
      "label": "How many suspects were there?",
      "type": "number",
      "defaultValue": 1,
      "step_title": "Suspect Information"
    },
    "suspect_description": {
      "label": "Please describe the suspect(s).",
      "type": "textarea",
      "placeholder": "Include details like gender, age, height, build, clothing, and any distinguishing features.",
      "validation": {
        "required": true
      },
      "step_title": "Suspect Information"
    },
    "weapon_involved": {
      "label": "Was a weapon used?",
      "type": "radio_group",
      "options": [
        "Yes",
        "No",
        "Unsure"
      ],
      "validation": {
        "required": true
      },
      "step_title": "Suspect Information"
    },
    "weapon_type": {
      "label": "What kind of weapon?",
      "type": "text",
      "placeholder": "e.g., knife, bat, firearm.",
      "conditional": {
        "field": "weapon_involved",
        "value": "Yes"
      },
      "step_title": "Suspect Information"
    },
    "vehicle_involved": {
      "label": "Was a vehilce used or sighted?",
      "type": "radio_group",
      "options": [
        "Yes",
        "No",
        "Unsure"
      ],
      "validation": {
        "required": true
      },
      "step_title": "Suspect Information"
    },
    "vehicle_description": {
      "label": "Description of any involved vehicles.",
      "type": "textarea",
      "placeholder": "Make, model, license plate.",
      "conditional": {
        "field": "vehicle_involved",
        "value": "Yes"
      },
      "step_title": "Suspect Information"
    },
    "evidence_upload": {
      "label": "Upload Photos or Videos",
      "type": "file_upload",
      "helperText": "Please upload any visual evidence related to the incident.",
      "step_title": "Evidence & Witnesses"
    },
    "witness_present": {
      "label": "Were there any witnesses?",
      "type": "radio_group",
      "options": [
        "Yes",
        "No",
        "Unsure"
      ],
      "step_title": "Evidence & Witnesses"
    },
    "witness_details": {
      "label": "Witness Information",
      "type": "repeater",
      "conditional": {
        "field": "witness_present",
        "value": "Yes"
      },
      "step_title": "Evidence & Witnesses",
      "fields": {
        "witness_name": {
          "label": "Witness Name",
          "type": "text"
        },
        "witness_contact": {
          "label": "Witness Contact Info",
          "type": "text"
        }
      }
    }
  }
}