# ==========================================
# Sirr Backend Environment Variables
# ==========================================
# Copy this file to .env and configure the values for your environment.

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here-make-it-long-and-random-at-least-50-characters-change-this-in-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_DB_NAME=sirr_dev
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=postgres
POSTGRES_DB_HOST=db
POSTGRES_DB_PORT=5432
POSTGRES_HOST_PORT=5432

# AI Service API Keys (Optional for AI Features)
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Vector Database Configuration (PostgreSQL with pgvector)
VECTOR_DB_NAME=vector_dev
VECTOR_HOST_PORT=5434
PG_HOST=localhost

# Email Configuration (Development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_HOST_PORT=6379

# Django Host Port Configuration
DJANGO_HOST_PORT=8000

NEXT_PUBLIC_API_URL=http://localhost:8000

# Django Super User configuration
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@sirr.com
DJANGO_SUPERUSER_PASSWORD=admin

# Admin Private Key
ADMIN_PRIVATE_KEY=

# Ollama Settings
OLLAMA_PATH=
